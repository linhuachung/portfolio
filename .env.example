# Copy to .env and fill in. Never commit real values.

# Database (Prisma)
DATABASE_URL=

# Admin auth — use two different long random strings
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public site URL used in email links (falls back to VERCEL_URL on Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# File uploads (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_FOLDER=
AWS_S3_IMAGES_FOLDER=
AWS_S3_BASE_URL=

# Gemini AI draft generation (server-only; never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_REPLY_MODEL=gemini-3.8-flash
